#!/bin/sh

# Read-only LuCI gateway. Keep arbitrary AT commands and every mutating action
# behind the write ACL granted to /usr/sbin/mt5700m-at.
AT_HELPER="${MT5700M_AT_HELPER:-/usr/sbin/mt5700m-at}"
CACHE_DIR="${MT5700M_READ_CACHE_DIR:-/tmp/mt5700m-read-cache}"
CACHE_TTL="${MT5700M_READ_CACHE_TTL:-5}"
CACHE_MAX_STALE="${MT5700M_READ_CACHE_MAX_STALE:-60}"
. "${MT5700M_LOCK_HELPER:-$(dirname "$0")/../share/mt5700m/lock.sh}"

case "${CACHE_TTL}" in ''|*[!0-9]*) CACHE_TTL=5 ;; esac
case "${CACHE_MAX_STALE}" in ''|*[!0-9]*) CACHE_MAX_STALE=60 ;; esac

cache_age() {
	local cache_file="$1" time_file="$2" now modified

	[ -f "${cache_file}" ] && [ -f "${time_file}" ] || return 1
	now="$(date +%s)"
	modified="$(cat "${time_file}" 2>/dev/null || true)"
	case "${modified}" in ''|*[!0-9]*) return 1 ;; esac
	[ "${modified}" -le "${now}" ] || return 1
	printf '%s\n' "$((now - modified))"
}

cache_fresh() {
	[ -n "$2" ] || return 1
	# The overview polls radio every TTL seconds; equality must refresh now.
	if [ "$1" = radio ]; then
		[ "$2" -lt "${CACHE_TTL}" ]
	else
		[ "$2" -le "${CACHE_TTL}" ]
	fi
}

valid_radio_snapshot() {
	awk -F= '
		/^carrier_count=/ {
			if ($2 !~ /^[0-9]+$/ || $2 + 0 < 1 || count_seen++) invalid=1
			count=$2 + 0
		}
		/^carrier_[0-9]+=/ {
			index_text=$1
			sub(/^carrier_/, "", index_text)
			index_value=index_text + 0
			if (index_value < 1 || seen[index_value]++) invalid=1
			if (split($2, field, "[|]") != 8 || field[1] !~ /^(NR|LTE)$/ ||
			    field[2] !~ /^(n|B)[0-9]+$/) invalid=1
			for (i=3; i<=8; i++)
				if (field[i] !~ /^[0-9]+([.][0-9]+)?$/) invalid=1
			records++
		}
		END {
			if (invalid || count_seen != 1 || records != count) exit 1
			for (i=1; i<=count; i++) if (!(i in seen)) exit 1
		}' "$1"
}

refresh_cache() (
	local key="$1" cache_file time_file lock_dir temporary error_file timestamp_file filtered_file age rc
	shift

	umask 077
	mkdir -p "${CACHE_DIR}" || return 1
	chmod 0700 "${CACHE_DIR}" 2>/dev/null || true
	cache_file="${CACHE_DIR}/${key}.cache"
	time_file="${CACHE_DIR}/${key}.time"
	lock_dir="${CACHE_DIR}/${key}.flock"
	exec 8>"${lock_dir}" || return 1
	flock -n 8 || return 75
	# A competing reader may have published while this request took the lock.
	age="$(cache_age "${cache_file}" "${time_file}" || true)"
	cache_fresh "${key}" "${age}" && return 0
	# Keep the action lock until snapshot publication: a write cannot invalidate
	# a cache and then have an older in-flight snapshot overwrite it.
	if [ "${key}" = radio ] &&
		! { [ "${MT5700M_ACTION_LOCKED:-0}" = 1 ] && [ -e /proc/self/fd/9 ]; }; then
		# Live carrier telemetry must never queue behind SMS or settings.
		exec 9>"${MT5700M_ACTION_LOCK:-/var/lock/mt5700m-action.lock}" || return 1
		flock -n 9 || return 75
		export MT5700M_ACTION_LOCKED=1
	else
		mt5700m_action_lock || return $?
	fi
	trap 'rm -f "${temporary:-}" "${error_file:-}" "${timestamp_file:-}" "${filtered_file:-}"' EXIT
	trap 'exit 1' HUP INT TERM

	temporary="$(mktemp "${CACHE_DIR}/.${key}.XXXXXX")" || {
		return 1
	}
	error_file="${temporary}.err"
	timestamp_file="${temporary}.time"
	if "${AT_HELPER}" "$@" >"${temporary}" 2>"${error_file}"; then
		if [ "${key}" = radio ]; then
			if ! valid_radio_snapshot "${temporary}"; then
				echo 'Incomplete carrier snapshot; keeping previous radio data' >&2
				return 1
			fi
			# Publish one timestamp for the entire validated cache snapshot.
			filtered_file="${temporary}.radio"
			sed '/^snapshot_at=/d' "${temporary}" >"${filtered_file}" || return 1
			mv -f "${filtered_file}" "${temporary}" || return 1
		fi
		date +%s >"${timestamp_file}"
		printf '\nsnapshot_at=%s\n' "$(cat "${timestamp_file}")" >>"${temporary}"
		chmod 0600 "${temporary}" "${timestamp_file}" 2>/dev/null || true
		mv -f "${temporary}" "${cache_file}"
		mv -f "${timestamp_file}" "${time_file}"
		rc=0
	else
		rc=$?
		cat "${error_file}" >&2
		rm -f "${temporary}"
	fi
	rm -f "${error_file}" "${timestamp_file}"
	return "${rc}"
)

cached_read() {
	local key="$1" cache_file time_file age rc
	shift
	cache_file="${CACHE_DIR}/${key}.cache"
	time_file="${CACHE_DIR}/${key}.time"
	age="$(cache_age "${cache_file}" "${time_file}" || true)"

	if cache_fresh "${key}" "${age}"; then
		cat "${cache_file}"
		return 0
	fi

	if [ "${key}" != radio ] && [ -n "${age}" ] && [ "${age}" -le "${CACHE_MAX_STALE}" ]; then
		cat "${cache_file}"
		(refresh_cache "${key}" "$@") </dev/null >/dev/null 2>&1 &
		return 0
	fi

	refresh_cache "${key}" "$@"
	rc=$?
	if [ "${rc}" -eq 75 ]; then
		# Another request is already producing the first snapshot. Wait briefly
		# for its atomic rename instead of launching a duplicate AT query batch.
		for _ in 1 2; do
			[ -f "${cache_file}" ] && break
			sleep 1
		done
	fi
	# A failed refresh must not present indefinitely old radio/session data.
	age="$(cache_age "${cache_file}" "${time_file}" || true)"
	[ -n "${age}" ] && [ "${age}" -le "${CACHE_MAX_STALE}" ] || return 1
	cat "${cache_file}"
}


# Signal requests are cache-only: only the procd collector may query the modem.
# Read one atomic snapshot and judge its actual sample time, never request time.
signal_read() {
 local snapshot stamp now
 snapshot="$(cat "${CACHE_DIR}/signal.cache" 2>/dev/null)" || return 75
 stamp="$(printf '%s\n' "${snapshot}" | sed -n 's/^sampled_at=//p')"
 case "${stamp}" in ''|*[!0-9]*) return 75 ;; esac
 now="$(date +%s)"
 [ "${stamp}" -le "${now}" ] && [ "$((now - stamp))" -le 30 ] || return 75
 printf '%s\n' "${snapshot}" | grep -q '^sysmode=' || return 75
 printf '%s\n' "${snapshot}"
}

case "${1:-}" in
	status)
		cached_read status "$@"
		exit $?
		;;
	radio-status)
		cached_read radio "$@"
		exit $?
		;;
	signal)
		signal_read "$@"
		exit $?
		;;
	temperature|network|cellscan-status|cellscan-result|sms-list|sms-info|sms-send-status|system|fota-state|fota-progress)
		exec "${AT_HELPER}" "$@"
		;;
	advanced)
		case "${2:-}" in
			session)
				cached_read session "$@"
				exit $?
				;;
			connection|connection-settings|radio|radio-diagnostics|hardware)
				exec "${AT_HELPER}" "$@"
				;;
		esac
		;;
esac

echo 'read-only MT5700M action denied' >&2
exit 64
